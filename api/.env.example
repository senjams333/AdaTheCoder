# Copy to .env and fill in. Never upload .env anywhere.
PORT=3000
HOST=127.0.0.1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=admin_db
DB_USER=Admin
DB_PASSWORD=your-mysql-password
DB_SYNC=true

JWT_SECRET=a-long-random-string
JWT_EXPIRES_IN=7d

BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=you@example.com
BREVO_SENDER_NAME=Ada The Coder
ADMIN_NOTIFY_EMAIL=you@example.com

SITE_URL=https://www.adathecoder.com

# This API's own public address (links to uploaded videos and pictures)
API_PUBLIC_URL=http://127.0.0.1:3000
# Websites allowed to call the API (comma-separated)
CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
# Uploaded videos, pictures and installers
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=500

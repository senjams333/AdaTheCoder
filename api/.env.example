# Copy to .env and fill in. Never upload .env anywhere.
PORT=3000
HOST=127.0.0.1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=admin_db
DB_USER=Admin
DB_PASSWORD=your-mysql-password
DB_SYNC=true

JWT_SECRET=a-long-random-string
JWT_EXPIRES_IN=7d

BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=you@example.com
BREVO_SENDER_NAME=Ada The Coder
ADMIN_NOTIFY_EMAIL=you@example.com

SITE_URL=https://www.adathecoder.com

# This API's own public address (links to uploaded videos and pictures)
API_PUBLIC_URL=http://127.0.0.1:3000
# Websites allowed to call the API (comma-separated)
CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
# Uploaded videos, pictures and installers
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=500

# Testing only: the sign-up answer (and the sign-up page) also show the emailed code. Never in production.
# DEV_SHOW_CODES=true

# ---- Payments (a method whose keys are empty is simply not offered) ----
# Razorpay (India: UPI, cards, net banking, in rupees). Dashboard → Account & Settings → API Keys.
# Each paid theme also needs "Price in rupees" in the admin, or Razorpay isn't shown for it.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks: URL https://<your API>/api/pay/razorpay/webhook, events payment.captured + order.paid
RAZORPAY_WEBHOOK_SECRET=
# PayPal (cards and PayPal, charged in PAYPAL_CURRENCY using the theme's Price). developer.paypal.com → Apps & Credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (test money) or live
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD

    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "check-node": "node scripts/check-node.js",
    "prebuild": "node scripts/check-node.js",
    "prestart": "node scripts/check-node.js",
    "prestart:dev": "node scripts/check-node.js",
    "prestart:prod": "node scripts/check-node.js",
    "pretest": "node scripts/check-node.js",
    "pretest:e2e": "node scripts/check-node.js",
    "theme": "ts-node src/cli/theme-pack.ts",

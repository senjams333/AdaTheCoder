# Copy these into your host's environment settings (Render, Railway, a VPS...).
ADA_ENV=production
# Make one with:  python -c "import secrets; print(secrets.token_hex(32))"
ADA_SECRET_KEY=change-me
# Keep the database and installers on a persistent disk:
ADA_DATABASE=/data/ada.sqlite3
ADA_UPLOAD_DIR=/data/uploads
ADA_MAX_UPLOAD_MB=500
# Optional. Normally the first visit to /admin/login creates the admin account.
# To create it from settings instead (only if no admin exists yet), fill these in, then remove them.
# ADA_ADMIN_EMAIL=you@example.com
# ADA_ADMIN_PASSWORD=a-long-password-here
